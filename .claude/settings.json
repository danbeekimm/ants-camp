{
  "permissions": {
    "allow": [
      "Bash(./gradlew build:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew archTest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(scripts/check-no-secrets.sh:*)",
      "Bash(scripts/mask-secrets.sh:*)"
    ],
    "ask": [
      "Bash(scripts/notify-slack.sh:*)",
      "Bash(docker compose:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./gh_prod_secret.sh)",
      "Bash(./deploy.sh:*)",
      "Bash(./gh_prod_secret.sh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh\""
          }
        ]
      }
    ]
  }
}
