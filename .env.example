# ──────────────────────────────────────────────────────────────────
# docker-compose.lite.yml (OCI 단일 인스턴스) 용 환경변수
# 사용: cp .env.example .env  후 값 채우기
# ──────────────────────────────────────────────────────────────────

# 배포 이미지 태그 (CD가 :latest push, 핀 고정하려면 커밋 SHA 지정)
IMAGE_TAG=latest

# ── DB (Postgres + pgvector) ──
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── Redis ──
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_URL=

# ── Kafka ──
KAFKA_PORT=9092

# ── Config Server (외부 git 백엔드) ──
CONFIG_SERVER_PORT=8888
CONFIG_SERVER_URL=http://config-server:8888
CONFIG_GIT_URI=
CONFIG_GIT_BRANCH=dev
CONFIG_GIT_USERNAME=
CONFIG_GIT_PASSWORD=

# ── Eureka ──
EUREKA_SERVER_PORT=8761

# ── Gateway / JWT ──
GATEWAY_SERVER_PORT=8080
JWT_SECRET=
JWT_ACCESS_TOKEN_EXPIRATION=

# ── 서비스 포트 & 스키마 ──
USER_SERVER_PORT=8082
USER_SCHEMA=users
TRADE_SERVER_PORT=8084
TRADE_SCHEMA=trade
ASSET_SERVER_PORT=8086
ASSET_SCHEMA=asset
COMPETITION_SERVER_PORT=8092
COMPETITION_SCHEMA=competition
RANKING_SERVER_PORT=8094
RANKING_SCHEMA=ranking
ASSISTANT_SERVER_PORT=8096
ASSISTANT_SCHEMA=assistant
NOTIFICATION_SERVER_PORT=8098
NOTIFICATION_SCHEMA=notification

# ── trade-service: 한국투자증권(KIS) 연동 ──
KIS_WS_URL=
KIS_APPROVAL_URL=
KIS_REST_URL=
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_APP_ACCESS=

# ── assistant-service: LLM ──
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=
GEMINI_API_KEY=

# ── 모니터링 ──
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
LOKI_PORT=3100

# ── 알림(Alertmanager → Slack) ──
SLACK_ALERTMANAGER_WEBHOOK_URL=
WEBHOOK_SHARED_SECRET=

# ── Claude Code 개발 보고(scripts/notify-slack.sh → Slack) ──
# Slack Incoming Webhook URL. 비워두면 Slack 보고를 건너뛴다(빌드/작업은 영향 없음).
CLAUDE_DEV_SLACK_WEBHOOK_URL=
